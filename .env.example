# Шаблон локальной конфигурации. Скопировать и править под себя:
#
#     cp .env.example .env
#
# `.env` в git не попадает (см. .gitignore). Все значения ниже — для локальной
# разработки через docker-compose. В самом шаблоне секретов нет и быть не должно.
#
# docker-compose.yml читает этот файл, если он есть, но не требует его: у каждой
# переменной в compose есть значение по умолчанию, совпадающее с приведённым здесь.
#
# Файл compose один и на локальный запуск, и на стенд. Всё, чем стенд отличается,
# перечислено в последнем разделе: там же лежит закрытый ключ, поэтому `.env`
# на сервере — chmod 600.

# ─── окружение ───────────────────────────────────────────────────────────────
# local | staging | production. Влияет на проверки конфигурации при старте:
# при `production` сервис откажется подниматься с включённым MOCK_AUTH.
ENVIRONMENT=local
DEBUG=true
LOG_LEVEL=info

# ─── аутентификация мини-приложения (тех. ТЗ 6, 9.3) ─────────────────────────
# MOCK_AUTH=true — подпись initData от MAX не проверяется, идентификатор
# пользователя берётся из заголовка X-Max-User-Id. Нужно, пока нет бота, токена
# и хостинга: мини-приложение открывается в обычном браузере.
#
# В продовой конфигурации ДОЛЖНО быть false (тех. ТЗ 9.3). Значение по умолчанию
# в коде — false; true включается только здесь, для локальной разработки.
MOCK_AUTH=true

# Токен бота MAX. Пока бота нет — пусто. От него зависит только транспорт
# доставки уведомлений в чат (тех. ТЗ 9.1, уточнение У25); вся остальная
# функциональность работает без токена.
MAX_BOT_TOKEN=

# ─── база и кэш ──────────────────────────────────────────────────────────────
POSTGRES_USER=navigator
POSTGRES_PASSWORD=navigator
POSTGRES_DB=navigator

# Внутри docker-сети хост — имя сервиса (`postgres`, `redis`).
DATABASE_URL=postgres://navigator:navigator@postgres:5432/navigator
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Создавать схему БД из моделей вместо прогона миграций. Нужно только до
# появления первой миграции aerich (домен users). В production запрещено.
DB_GENERATE_SCHEMAS=true

# Источники, которым Core API разрешает кросс-доменные запросы. Список через
# запятую. Cookie не используются, поэтому credentials не разрешаются.
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Адреса для интеграционных тестов. Отдельная база — требование тех. ТЗ 7.
# Хост здесь localhost, а не имя сервиса: тесты запускаются с машины
# разработчика, а не внутри docker-сети. Значения по умолчанию совпадают с
# приведёнными, переопределять нужно только при нестандартных портах.
# TEST_DATABASE_URL=postgres://navigator:navigator@localhost:5432/navigator_test
# TEST_REDIS_URL=redis://localhost:6379/15

# ─── Внешние источники (уточнения У3, У8) ────────────────────────────────────
# Каждый источник закрыт интерфейсом с двумя реализациями, выбор — здесь.
#
# hh | fixture. Вакансии hh.ru реальны с самого начала (уточнение У14), но
# требуют выхода в интернет: за закрытым периметром ставьте fixture.
SOURCE_VACANCIES=hh

# fixture. Проходные баллы и бюджетные места — демонстрационные (уточнение У3):
# открытых данных приёмных кампаний в проекте пока нет.
SOURCE_ADMISSION=fixture

# fixture. Конкурсные списки — демонстрационные (уточнение У3): живого парсинга
# открытых списков в проекте нет.
SOURCE_COMPETITION_LISTS=fixture

# fixture. Расписание групп — демонстрационное (уточнение У3): живых выгрузок
# из вузов в проекте нет.
SOURCE_TIMETABLES=fixture

# fixture. Точки питания должны быть настоящими (уточнение У3), но ключа к
# картам в проекте пока нет.
SOURCE_FOOD=fixture

# in_app. Транспорт уведомлений (уточнение У25): очередь в базе показывает
# мини-приложение. Отправка в чат MAX включается вместе с ботом и токеном.
NOTIFICATION_TRANSPORT=in_app

# ─── админка (уточнение У26, тех. ТЗ 9.4) ────────────────────────────────────
# Отдельное приложение и отдельная роль: с пользовательскими токенами MAX доступ
# админа не пересекается, MOCK_AUTH на него не влияет.
#
# Без ADMIN_PASSWORD админка **не поднимается** — в её очереди лежат тексты
# обращений пользователей, и открытой она быть не может ни в одном окружении.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_PORT=8001

# ─── AI Gateway (тех. ТЗ 1.2, 5) ─────────────────────────────────────────────
# Core API обращается к шлюзу только по внутреннему имени: наружу порт шлюза
# не публикуется.
AI_GATEWAY_URL=http://ai-gateway:8100
# Сколько Core API ждёт ответа шлюза. За ответом стоит вызов модели, поэтому
# больше обычного запроса и не меньше LLM_TIMEOUT_SECONDS ниже.
AI_GATEWAY_TIMEOUT_SECONDS=25

# mock | yandexgpt | gigachat. `mock` — детерминированный ответ без сети,
# по умолчанию для локальной разработки и тестов (тех. ТЗ 7).
LLM_PROVIDER=mock
LLM_TIMEOUT_SECONDS=20
LLM_CACHE_TTL_SECONDS=300

# Клиенты обоих провайдеров написаны, но с живыми API не сверены: ключей нет,
# домены закрыты сетевой политикой окружения разработки. Снимать LLM_PROVIDER=mock
# до сверки нельзя — на разборе ответа держится модерация вопросов блока 5.
YANDEX_GPT_API_KEY=
YANDEX_GPT_FOLDER_ID=
# Резервный провайдер (тех. ТЗ 5, п. 3). Без ключа резерва нет, и шлюз честно
# отдаёт отказ основного, а не подменяет его заглушкой.
GIGACHAT_API_KEY=

# ─── фронтенд (сборка Vite) ──────────────────────────────────────────────────
# Базовый URL Core API с точки зрения браузера.
#
# Пусто — «тот же адрес, что и фронт»: запросы уходят на /api/v1/... и
# dev-сервер проксирует их в core-api по docker-сети. Так браузеру хватает
# одного порта (5173), а занятый порт Core API не ломает приложение.
#
# Полный адрес (например, http://localhost:8010) нужен только если фронт и
# бэкенд подняты порознь и без прокси.
VITE_API_BASE_URL=
# Идентификатор пользователя, который фронт подставляет в X-Max-User-Id,
# пока MOCK_AUTH включён.
VITE_MOCK_MAX_USER_ID=mock-user-1

# ─── порты, публикуемые на localhost ─────────────────────────────────────────
# Порт Core API нужен только разработчику — для /docs и curl. По умолчанию
# 8010, а не 8000: восьмитысячный занят на машинах разработчиков чаще всех
# прочих, а занятый порт означает, что контейнер не стартует вовсе.
CORE_API_PORT=8010
MINIAPP_PORT=5173
POSTGRES_PORT=5432
REDIS_PORT=6379

# ─── точка входа: nginx и TLS (решение Р76) ──────────────────────────────────
# Локально этот раздел можно не трогать: без TLS_CERT и TLS_KEY nginx возьмёт
# самоподписанный сертификат на один год и напишет об этом в лог. Браузер
# будет ругаться — так и должно быть, настоящий сертификат нужен только стенду.
#
# Домен стенда. Локально не нужен: в конфиге стоит `server_name _`, и сайт
# отдаётся по любому имени. Значение используется только как CN временного
# самоподписанного сертификата и в проверке живости из update.sh.
DOMAIN=localhost

# Открытая часть — сертификат вместе с промежуточными («fullchain»), и закрытый
# ключ к нему. Оба в формате PEM.
#
# Принимаются в двух видах: PEM как есть и он же в base64. В `.env` практичнее
# base64 — значение становится однострочным, и его не портят ни переносы, ни
# кавычки:
#
#     echo "TLS_CERT=$(base64 -w0 fullchain.pem)" >> .env
#     echo "TLS_KEY=$(base64 -w0 privkey.pem)"    >> .env
#     chmod 600 .env
#
# Задать нужно обе или ни одной: с одной из двух nginx откажется стартовать,
# потому что это почти всегда опечатка в имени переменной, а не намерение.
# Соответствие ключа сертификату проверяет сам nginx — на перепутанной паре
# контейнер не поднимется и напишет, что именно не так.
#
# Продление ручное: автоматического выпуска здесь больше нет. Срок годности
# смотреть так — `openssl x509 -in fullchain.pem -noout -enddate`.
TLS_CERT=
TLS_KEY=

# Порты точки входа. Меняются только если 80 и 443 на машине уже заняты.
HTTP_PORT=80
HTTPS_PORT=443

# ─── только для стенда ───────────────────────────────────────────────────────
# Локально это трогать не нужно. На сервере в `.env` дополнительно лежит:
#
#     ENVIRONMENT=staging     # не production: подпись initData ещё не сверена
#     DEBUG=false             # тех. ТЗ 9.7
#     MOCK_AUTH=true          # следствие предыдущей строки
#     CORS_ALLOW_ORIGINS=     # пусто: фронт и API на одном домене за nginx
#     DOMAIN=<домен стенда>
#     TLS_CERT=..., TLS_KEY=...
#     POSTGRES_PASSWORD=<настоящий>
#     ADMIN_PASSWORD=<настоящий>
#
# Тег образов. Пусто/latest — последняя сборка main; на стенде выставляется
# скриптом выкладки в SHA коммита, чтобы всегда было видно, что выложено,
# а откат сводился к запуску с прежним значением (решение Р70).
IMAGE_TAG=latest
