# Скопируй в .env и заполни реальными значениями. .env в Git не попадает.
#
# Локально: docker-compose.yml + docker-compose.dev.yml (код с reload, порты
# backend/БД). Строка ниже позволяет запускать просто `docker compose up`.
# Разделитель — «:», на Windows — «;».
COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml
#
# Timeweb App Platform: файла .env на сервере нет — те же переменные задаются
# в панели приложения (без COMPOSE_FILE), минимум: APP_URL, POSTGRES_PASSWORD,
# SESSION_SECRET, MAX_BOT_TOKEN, MAX_WEBHOOK_SECRET, MAX_BOT_USERNAME.

# --- Приложение ---
APP_ENV=development
APP_URL=http://localhost:8000
LOG_LEVEL=INFO

# --- Nginx (точка входа, раздел 41/72 тех-доки) ---
# Хост-порты nginx. 80/443 на App Platform заняты платформой (она же
# терминирует TLS и проксирует домен на HTTP_PORT). HTTPS_PORT — только
# локально (docker-compose.dev.yml), сертификат — см. nginx/README.md.
HTTP_PORT=8080
HTTPS_PORT=8443

# --- Сборка frontend (образ nginx) ---
# Реестр npm для `npm ci`. Если сборочная машина не достаёт до npmjs
# («npm error network»), укажи зеркало: https://registry.npmmirror.com/
# Целостность пакетов всё равно проверяется по package-lock.json.
NPM_REGISTRY=https://registry.npmjs.org/

# --- База данных ---
# Значения ниже используются и контейнером postgres, и backend
POSTGRES_USER=max_hiring
POSTGRES_PASSWORD=change_me
POSTGRES_DB=max_hiring
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgres://max_hiring:change_me@postgres:5432/max_hiring

# DSN для pytest с машины разработчика (вне Docker): имя `postgres` резолвится
# только внутри сети Compose, наружу порт проброшен на localhost.
TEST_DATABASE_URL=postgres://max_hiring:change_me@localhost:5432/max_hiring

# --- MAX ---
# Токен бота: используется для проверки подписи initData и для Bot API.
MAX_BOT_TOKEN=
# Секрет webhook'а. Это ДРУГОЙ секрет, не равен MAX_BOT_TOKEN.
MAX_WEBHOOK_SECRET=
# Публичное имя бота (без @) — для кнопки "открыть приложение" в уведомлениях.
MAX_BOT_USERNAME=

# --- Сессии ---
SESSION_SECRET=
# Время жизни серверной сессии, часы
SESSION_TTL_HOURS=720
# Имя cookie сессии
SESSION_COOKIE_NAME=max_hiring_session
# Максимальный возраст initData, секунды
AUTH_DATE_MAX_AGE_SECONDS=86400
# Максимум запросов POST /auth/max с одного адреса за окно
AUTH_RATE_LIMIT_REQUESTS=120
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
# Как часто авторизация запускает очистку просроченных сессий
SESSION_CLEANUP_INTERVAL_SECONDS=300

# Максимум откликов одного кандидата за окно (раздел 78)
APPLY_RATE_LIMIT_REQUESTS=30
APPLY_RATE_LIMIT_WINDOW_SECONDS=60

# Максимум попыток бронирования слота одним кандидатом за окно (раздел 78)
BOOK_RATE_LIMIT_REQUESTS=30
BOOK_RATE_LIMIT_WINDOW_SECONDS=60

# --- Redis / кэш ---
# Не из тех-доки — раздел 72 относит Redis к опциональной инфраструктуре.
# Пусто — кэш выключен, приложение работает напрямую с БД.
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
# DSN для pytest с машины разработчика (вне Docker) — своя БД Redis (индекс 1),
# чтобы тестовый кэш не пересекался с данными разработки
TEST_REDIS_URL=redis://localhost:6379/1
CACHE_SESSION_TTL_SECONDS=60
CACHE_FEED_POOL_TTL_SECONDS=60
CACHE_VACANCY_VIEW_TTL_SECONDS=60
CACHE_EMPLOYER_VACANCIES_TTL_SECONDS=30

# --- Вакансии ---
# Не более стольких черновиков (status=draft) одновременно у одного
# работодателя; продуктовое ограничение, не из тех-доки
VACANCY_DRAFT_LIMIT=5

# --- Интервью ---
# Допустимая длительность слота собеседования
INTERVIEW_SLOT_MIN_DURATION_MINUTES=5
INTERVIEW_SLOT_MAX_DURATION_HOURS=8

# --- Уведомления и бот ---
# false отключает отправку сообщений в MAX, не трогая остальной backend
BOT_ENABLED=true
MAX_WEBHOOK_PATH=/webhook/max
# Пусто — адрес webhook собирается как APP_URL + MAX_WEBHOOK_PATH
MAX_WEBHOOK_URL=
NOTIFICATION_MAX_ATTEMPTS=3
NOTIFICATION_RETRY_DELAY_SECONDS=0.5
NOTIFICATION_TIMEZONE=Europe/Moscow

# --- Локальное файловое хранилище ---
STORAGE_ROOT=/app/storage
AVATAR_MAX_SIZE_BYTES=5242880
AVATAR_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp

# --- AI (P1, для P0 не требуется) ---
# Раздел 71 тех-доки фиксирует только эти две переменные как минимум; ниже —
# реальная интеграция двумя провайдерами (раздел 58): если недоступен или
# перегружен один, `AI_PROVIDER_ORDER` задаёт, кого пробовать следующим.
AI_API_URL=
AI_API_KEY=
AI_REQUEST_TIMEOUT_SECONDS=15
AI_PROVIDER_ORDER=gigachat,yandexgpt

# GigaChat (https://developers.sber.ru/docs/ru/gigachat/api/overview)
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_OAUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
GIGACHAT_API_URL=https://gigachat.devices.sberbank.ru/api/v1
GIGACHAT_MODEL=GigaChat
# Публичный корневой сертификат CA Минцифры — не секрет, лежит в репозитории
# (backend/certs/), путь относительный от backend/ и одинаков везде
GIGACHAT_CA_BUNDLE_FILE=certs/russian_trusted_root_ca.crt
# true — проверять TLS-сертификат GigaChat; отключать (false) только для
# локальной отладки без CA-бандла
GIGACHAT_VERIFY_SSL=true

# YandexGPT и SpeechKit — через официальный yandex-ai-studio-sdk (gRPC),
# поэтому REST-адреса не нужны: эндпоинт SDK резолвит сам по FOLDER_ID.
# (https://yandex.cloud/ru/docs/foundation-models/) Один облачный аккаунт на оба.
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_GPT_MODEL=yandexgpt
# Пусто — используется YANDEX_API_KEY; задать отдельно, если для SpeechKit
# в Yandex Cloud заведён отдельный сервисный аккаунт
YANDEX_SPEECHKIT_API_KEY=
YANDEX_SPEECHKIT_LANG=ru-RU
