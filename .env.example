# Скопируй в .env и заполни реальными значениями. .env в Git не попадает.

# --- Приложение ---
APP_ENV=development
APP_URL=http://localhost:8000
LOG_LEVEL=INFO

# --- База данных ---
# Значения ниже используются и контейнером postgres, и backend
POSTGRES_USER=max_hiring
POSTGRES_PASSWORD=change_me
POSTGRES_DB=max_hiring
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgres://max_hiring:change_me@postgres:5432/max_hiring

# DSN для pytest с машины разработчика (вне Docker): имя `postgres` резолвится
# только внутри сети Compose, наружу порт проброшен на localhost.
TEST_DATABASE_URL=postgres://max_hiring:change_me@localhost:5432/max_hiring

# --- MAX ---
# Токен бота: используется для проверки подписи initData и для Bot API.
MAX_BOT_TOKEN=
# Секрет webhook'а. Это ДРУГОЙ секрет, не равен MAX_BOT_TOKEN.
MAX_WEBHOOK_SECRET=

# --- Сессии ---
SESSION_SECRET=
# Время жизни серверной сессии, часы
SESSION_TTL_HOURS=720
# Имя cookie сессии
SESSION_COOKIE_NAME=max_hiring_session
# Максимальный возраст initData, секунды
AUTH_DATE_MAX_AGE_SECONDS=86400
# Максимум запросов POST /auth/max с одного адреса за окно
AUTH_RATE_LIMIT_REQUESTS=120
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
# Как часто авторизация запускает очистку просроченных сессий
SESSION_CLEANUP_INTERVAL_SECONDS=300

# Максимум откликов одного кандидата за окно (раздел 78)
APPLY_RATE_LIMIT_REQUESTS=30
APPLY_RATE_LIMIT_WINDOW_SECONDS=60

# Максимум попыток бронирования слота одним кандидатом за окно (раздел 78)
BOOK_RATE_LIMIT_REQUESTS=30
BOOK_RATE_LIMIT_WINDOW_SECONDS=60

# --- Интервью ---
# Допустимая длительность слота собеседования
INTERVIEW_SLOT_MIN_DURATION_MINUTES=5
INTERVIEW_SLOT_MAX_DURATION_HOURS=8

# --- Уведомления и бот ---
# false отключает отправку сообщений в MAX, не трогая остальной backend
BOT_ENABLED=true
MAX_WEBHOOK_PATH=/webhook/max
# Пусто — адрес webhook собирается как APP_URL + MAX_WEBHOOK_PATH
MAX_WEBHOOK_URL=
NOTIFICATION_MAX_ATTEMPTS=3
NOTIFICATION_RETRY_DELAY_SECONDS=0.5
NOTIFICATION_TIMEZONE=Europe/Moscow

# --- Локальное файловое хранилище ---
STORAGE_ROOT=/app/storage
AVATAR_MAX_SIZE_BYTES=5242880
AVATAR_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp

# --- AI (P1, для P0 не требуется) ---
AI_API_URL=
AI_API_KEY=
