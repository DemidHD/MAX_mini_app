# Единственная точка входа стенда.
#
# Caddy выбран не за моду: сертификат Let's Encrypt он выпускает и продлевает
# сам, без cron и certbot, а весь конфиг — двадцать строк вместо страницы
# директив nginx. Для стенда, который поднимает один человек, это решающее.
#
# Одно правило, из которого следует всё остальное: фронтенд и API живут на
# **одном** домене. Поэтому браузер не делает кросс-доменных запросов, CORS не
# участвует, а мини-приложению внутри WebView мессенджера MAX не нужно знать
# отдельный адрес бэкенда (решение Р67).

{
	# Боевой центр сертификации задан явно: в логах стенда всплывал staging,
	# а его сертификат браузер не считает доверенным — внешне это неотличимо
	# от «сертификата нет».
	acme_ca https://acme-v02.api.letsencrypt.org/directory
}

{$DOMAIN} {
	encode zstd gzip

	# Испытание dns-01: владение доменом подтверждается временной записью
	# в DNS, а не ответом на входящее подключение.
	#
	# Это единственный оставшийся способ. `tls-alpn-01` и `http-01` оба
	# требуют, чтобы Let's Encrypt достучался до сервера снаружи, и оба
	# провалились здесь одинаково — «Timeout after connect», при том что те же
	# запросы изнутри сервера отрабатывают мгновенно (решение Р72). Направление
	# «сервер наружу» исправно, поэтому испытание, которое ходит только наружу,
	# проходит.
	#
	# Токен приходит из окружения и в репозитории не хранится. Если переменная
	# не задана, Caddy не поднимется — и это правильнее, чем подняться без TLS
	# и молча отдавать стенд по HTTP.
	#
	# resolvers заданы явно: проверяя, разошлась ли запись, Caddy иначе спросил
	# бы резолвер хостинга, а тот отдаёт свой кеш и может отвечать устаревшим
	# ещё долго после того, как запись уже видна снаружи.
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
		resolvers 1.1.1.1 8.8.8.8
	}

	# API — по префиксу.
	handle /api/* {
		reverse_proxy core-api:8000
	}

	# Проба живости наружу: деплой убеждается, что стенд поднялся, не заходя
	# на сервер по SSH.
	handle /health {
		reverse_proxy core-api:8000
	}

	# Всё остальное — статика мини-приложения. SPA-фолбэк настроен внутри её
	# nginx, поэтому здесь просто проксирование.
	handle {
		reverse_proxy miniapp:80
	}

	header {
		# Заголовки безопасности. CSP намеренно не задаётся: требования
		# платформы MAX к WebView лежат в закрытой документации (тех. ТЗ 9.7)
		# и ещё не сверены — выставить её наугад значит сломать приложение
		# внутри мессенджера.
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	log {
		output stdout
		format console
	}
}

# Дополнительные сайты — файлами рядом. Глоб без совпадений Caddy не считает
# ошибкой, поэтому по умолчанию здесь не подключается ничего.
#
# Так сделана админка: подставлять `{$ADMIN_DOMAIN}` прямо в конфиг нельзя —
# незаданная переменная превратилась бы в пустой адрес сайта, и Caddy не
# поднялся бы вовсе, уронив вместе с собой весь стенд. Как включить —
# в `conf.d/admin.caddy.example`.
import /etc/caddy/conf.d/*.caddy
