[Unit]
Description=Проверять GHCR на новую сборку «Навигатора»

[Timer]
# Первая проверка вскоре после загрузки — так стенд поднимается сам после
# перезагрузки сервера, без чьего-либо участия.
OnBootSec=1min
# Отсчёт от завершения прошлого запуска, а не от его начала: пока идёт
# выкладка, следующая проверка не встаёт в очередь.
OnUnitActiveSec=1min
AccuracySec=5s

[Install]
WantedBy=timers.target
